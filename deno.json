{
  "version": "0.0.1",
  "unstable": ["kv", "cron", "bundle"],
  "lint": {
    "include": ["src", "tasks"],
    "exclude": ["dist/", "node_modules/", ".data"],
    "rules": {
      "tags": ["recommended", "react", "jsx"],
      "include": ["no-import-prefix"],
      "exclude": ["no-explicit-any"]
    }
  },
  "fmt": {
    "indentWidth": 2
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns",
      "deno.unstable"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true
  },
  "tasks": {
    "manifest": "deno run -A ./tasks/dev.ts",
    "webhook": "deno run -A ./tasks/post_webhook.ts",
    "dev": "deno task manifest && deno run --watch --allow-import --allow-env --allow-read --allow-write --allow-net src/main.tsx",
    "dev:inspect": "deno task manifest && deno run --inspect-wait --watch --allow-env --allow-read --allow-write --allow-net src/main.tsx",
    "get-deploy-project": "deno run -A ./tasks/print_env.ts DENO_DEPLOY_PROJECT",
    "get-deploy-token": "deno run -A ./tasks/print_env.ts DENO_DEPLOY_TOKEN",
    "minify": "deno run -A npm:terser --module --source-map -o ./dist/main.min.js ./dist/main.js",
    "bundle": "deno task manifest && deno run  --allow-env --allow-read --allow-write --allow-net --allow-run --allow-import ./tasks/bundle.ts",
    "deploy": "deno task bundle && deno run -A ./tasks/deploy.ts",
    "generate-secret": "deno run tasks/generate_secret.ts"
  },
  "bench": {
    "files": {
      "include": ["./bench/mod.ts"]
    }
  },
  "imports": {
    "$apis/": "./apis.gen/",
    "$manifest": "./manifest.gen.ts",
    "$interfaces/": "./src/interfaces/",
    "$infrastructure/": "./src/infrastructure/",
    "$application/": "./src/application/",
    "@b-fuze/deno-dom": "jsr:@b-fuze/deno-dom@0.1.56",
    "@grammyjs/hydrate": "https://deno.land/x/grammy_hydrate@v1.7.0/mod.ts",
    "@grammyjs/hydrate/": "https://deno.land/x/grammy_hydrate@v1.7.0/",
    "@grammyjs/types": "https://deno.land/x/grammy_types@v3.28.0/mod.ts",
    "@grammyjs/types/": "https://deno.land/x/grammy_types@v3.28.0/mod.ts/",
    "@grammyjs/auto-retry": "https://deno.land/x/grammy_auto_retry@v2.0.2/mod.ts",
    "@hey-api/openapi-ts": "npm:@hey-api/openapi-ts@^0.98.2",
    "@luca/esbuild-deno-loader": "jsr:@luca/esbuild-deno-loader@0.11.1",
    "@octokit/core": "npm:@octokit/core@7.0.6",
    "@inquirer/prompts": "npm:@inquirer/prompts@^8.5.2",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/async": "jsr:@std/async@^1.4.0",
    "@std/cli": "jsr:@std/cli@1.0.30",
    "@std/collections": "jsr:@std/collections@1.2.0",
    "@std/crypto": "jsr:@std/crypto@1.1.0",
    "@std/dotenv": "jsr:@std/dotenv@0.225.7",
    "@std/encoding": "jsr:@std/encoding@1.0.10",
    "@std/fmt": "jsr:@std/fmt@1.0.10",
    "@std/fs": "jsr:@std/fs@1.0.24",
    "@std/http": "jsr:@std/http@1.1.1",
    "@std/log": "jsr:@std/log@^0.224.14",
    "@std/media-types": "jsr:@std/media-types@1.1.0",
    "@std/path": "jsr:@std/path@1.1.5",
    "@std/random": "jsr:@std/random@0.1.5",
    "commander": "npm:commander@^15.0.0",
    "@std/streams": "jsr:@std/streams@1.1.1",
    "@types/react": "npm:@types/react@^19.2.17",
    "@types/react-dom": "npm:@types/react-dom@^19.2.3",
    "grammy": "https://deno.land/x/grammy@v1.44.0/mod.ts",
    "iteretijs": "npm:iteretijs@0.2.3",
    "react": "npm:react@^19.2.7",
    "react-dom": "npm:react-dom@^19.2.7",
    "telegraf-middleware-console-time": "npm:telegraf-middleware-console-time@^3.0.0",
    "typescript": "npm:typescript@^6.0.3",
    "zod": "npm:zod@^4.4.3"
  },
  "deploy": {
    "exclude": ["**/node_modules"],
    "include": ["dist/**/*", "public/**/*"],
    "entrypoint": "dist/main.js"
  }
}
