{
  "name": "davibot",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "predev": "pnpm manifest",
    "dev": "wrangler dev",
    "dev:tunnel": "pnpm dev --tunnel",
    "dev:inspect": "pnpm manifest && wrangler dev --inspect",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "manifest": "tsx ./tasks/dev.ts",
    "webhook": "tsx ./tasks/post_webhook.ts",
    "minify": "pnpx terser --module --source-map -o ./dist/main.min.js ./dist/main.js",
    "deploy": "pnpm manifest && wrangler deploy --minify",
    "generate-secret": "tsx tasks/generate_secret.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/hydrate": "^1.7.0",
    "@inquirer/prompts": "^8.5.2",
    "@luca/esbuild-deno-loader": "jsr:0.11.1",
    "@octokit/core": "^7.0.6",
    "@std/async": "jsr:^1.4.0",
    "@std/collections": "jsr:1.2.0",
    "@std/crypto": "jsr:1.1.0",
    "@std/encoding": "jsr:1.0.10",
    "@std/fmt": "jsr:1.0.10",
    "@std/log": "jsr:^0.224.14",
    "@std/media-types": "jsr:1.1.0",
    "@std/random": "jsr:0.1.5",
    "@std/streams": "jsr:1.1.1",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "grammy": "^1.44.0",
    "hono": "^4.12.26",
    "iteretijs": "^0.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "telegraf-middleware-console-time": "^3.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "@hey-api/openapi-ts": "^0.98.2",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "chalk": "^5.6.2",
    "domhandler": "^6.0.1",
    "dotenv": "^17.4.2",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.103.0"
  },
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26"
}
